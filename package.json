{
  "name": "prof-controller",
  "version": "1.1.0",
  "description": "ProF Controller - Gestor de Patrimônio Offline 100% Privado",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "start": "python -m http.server 8000 || npx http-server -p 8000",
    "build": "echo 'No build step - this is a static PWA'",
    "serve": "npx http-server --cors -p 8000",
    "lint": "echo 'Linting not required for vanilla JS'",
    "test": "echo 'Manual testing required'",
    "optimize": "node scripts/optimize-assets.js",
    "capacitor:init": "npx cap init --web-dir . prof-controller com.profcontroller.app",
    "capacitor:add-android": "npx cap add android",
    "capacitor:add-ios": "npx cap add ios",
    "capacitor:build-android": "npx cap build android",
    "capacitor:build-ios": "npx cap build ios",
    "capacitor:sync": "npx cap sync",
    "capacitor:open-android": "npx cap open android",
    "capacitor:open-ios": "npx cap open ios",
    "electron-start": "cross-env REACT_APP_ENV=production electron .",
    "electron-dev": "concurrently \"npm start\" \"wait-on http://localhost:8000 && electron .\"",
    "electron-build": "npm run build && electron-builder",
    "electron-build-win": "npm run electron-build -- --win",
    "electron-build-mac": "npm run electron-build -- --mac",
    "electron-build-linux": "npm run electron-build -- --linux"
  },
  "keywords": [
    "financial",
    "portfolio",
    "investments",
    "offline",
    "privacy",
    "crypto",
    "stocks",
    "wealth",
    "tracking"
  ],
  "author": {
    "name": "ProF Controller",
    "email": "contact@profcontroller.app"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ferpa2505-art/prof-controller.git"
  },
  "homepage": "https://github.com/ferpa2505-art/prof-controller#readme",
  "bugs": {
    "url": "https://github.com/ferpa2505-art/prof-controller/issues"
  },
  "engines": {
    "node": ">=12.0.0"
  },
  "devDependencies": {
    "http-server": "^14.1.1",
    "electron": "^29.0.0",
    "electron-builder": "^24.9.1",
    "@capacitor/cli": "^5.0.0",
    "@capacitor/core": "^5.0.0",
    "@capacitor/android": "^5.0.0",
    "@capacitor/ios": "^5.0.0",
    "concurrently": "^8.0.0",
    "wait-on": "^7.0.0",
    "cross-env": "^7.0.0"
  },
  "dependencies": {},
  "build": {
    "appId": "com.profcontroller.app",
    "productName": "ProF Controller",
    "files": [
      "index.html",
      "app.js",
      "styles.css",
      "service-worker.js",
      "manifest.json",
      "icon-192.png",
      "icon-512.png",
      "electron/main.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "certificateFile": null,
      "certificatePassword": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ProF Controller"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.finance"
    },
    "linux": {
      "target": [
        "zip"
      ],
      "category": "Office"
    },
    "directories": {
      "buildResources": "assets",
      "output": "release"
    }
  },
  "browserslist": [
    "last 2 versions",
    "> 1%",
    "not dead",
    "chrome >= 55",
    "firefox >= 45",
    "safari >= 11",
    "edge >= 79"
  ]
}
