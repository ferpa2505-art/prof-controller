{
  "name": "prof-controller",
  "version": "1.2.0",
  "description": "ProF Controller - Gestor de patrimônio multi-moeda, offline e 100% privado",
  "main": "electron/main.js",
  "homepage": "https://ferpa2505-art.github.io/prof-controller/",
  "scripts": {
    "start": "npx http-server -p 8000 -c-1",
    "build": "node scripts/build-www.mjs",
    "test:security": "node --test tests/security.test.mjs",
    "serve:www": "npm run build && npx http-server www -p 8001 -c-1",
    "cap:sync": "npm run build && npx cap sync",
    "android:open": "npm run cap:sync && npx cap open android",
    "android:run": "npm run cap:sync && npx cap run android",
    "ios:open": "npm run cap:sync && npx cap open ios",
    "ios:run": "npm run cap:sync && npx cap run ios",
    "electron:start": "npm run build && electron .",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:build:linux": "npm run build && electron-builder --linux"
  },
  "keywords": [
    "financial",
    "portfolio",
    "investments",
    "offline",
    "privacy",
    "crypto",
    "stocks",
    "wealth",
    "tracking"
  ],
  "author": {
    "name": "Luís Fernando Paulino"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ferpa2505-art/prof-controller.git"
  },
  "bugs": {
    "url": "https://github.com/ferpa2505-art/prof-controller/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "http-server": "^14.1.1"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-native-biometric": "^8.8.1"
  },
  "build": {
    "appId": "com.profcontroller.app",
    "productName": "ProF Controller",
    "files": [
      "www/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build-resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ProF Controller"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.finance",
      "icon": "build-resources/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build-resources/icon.png"
    },
    "directories": {
      "buildResources": "build-resources",
      "output": "release"
    },
    "copyright": "© 2026 Luís Fernando Paulino"
  }
}